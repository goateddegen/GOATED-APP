# =============================================================================
# GOATED — environment template
# =============================================================================
# Copy to .env.local and fill THAT file. .env.local is gitignored.
# Production values go in the Vercel project environment, not in git.
# Leave every secret in this file blank. Do not commit a filled copy.
#
# VITE_* names are shipped to the browser. Only the Supabase URL, the
# Supabase publishable key, and VITE_LAUNCH_READY belong in that prefix.
# =============================================================================


# =============================================================================
# LLM — /api/chat, /api/audit, /api/intelligence
# xAI when XAI_API_KEY is set, otherwise Groq (api/_lib/llm.js).
# =============================================================================

# https://console.x.ai
XAI_API_KEY=

# https://console.groq.com/keys
# Default model qwen/qwen3.8-27b. Optional override:
# GROQ_CHAT_MODEL=
GROQ_API_KEY=


# =============================================================================
# P0 — MONEY RAILS (Stripe Connect with Application Fees: 12% / 3%)
# =============================================================================

# Stripe — live + test keys. Required for deposits, retainers, rev-share auto-split.
#   Signup:  https://dashboard.stripe.com/register
#   Keys:    https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Connect — required for Application Fee auto-split to client sub-accounts.
#   Enable:  https://dashboard.stripe.com/settings/connect
#   Client ID format: ca_xxxxxxxxxx
STRIPE_CONNECT_CLIENT_ID=

# Stripe Webhooks — required to record deal close + apply platform fee.
#   Configure:  https://dashboard.stripe.com/webhooks
#   Events:     checkout.session.completed, charge.succeeded, transfer.created
STRIPE_WEBHOOK_SECRET=


# =============================================================================
# P0 — OUTBOUND STACK (NO EMAIL — voice + SMS + LinkedIn only)
# =============================================================================

# Vapi — AI voice agent (cold calls, missed-call rescue, no-show recovery).
#   Signup:        https://dashboard.vapi.ai
#   Keys:          https://dashboard.vapi.ai/account
#   Phone number:  https://dashboard.vapi.ai/phone-numbers
#   Free:          Pay-as-you-go, ~$0.05/min inbound+outbound
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# Twilio — SMS rail (reactivation, drip, booking confirms).
#   Signup:  https://www.twilio.com/try-twilio
#   Console: https://console.twilio.com
#   Tier:    $15 trial credit, then pay-as-you-go
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Unipile — LinkedIn DMs + InMail + connections via unified API.
#   Signup:  https://www.unipile.com/
#   Docs:    https://developer.unipile.com/
#   Tier:    Paid from day 1 (~$29/mo starter) — critical for no-email outbound
UNIPILE_API_KEY=
UNIPILE_DSN=

# Cal.com — Booking rail. AI agent drops link into convo, caller books.
#   Signup:  https://cal.com/signup
#   Keys:    https://app.cal.com/settings/developer/api-keys
#   Tier:    Free forever for personal
CAL_API_KEY=
CAL_USERNAME=


# =============================================================================
# P0 — AUTH + DATABASE (Supabase — audits, users, leads, transactions)
# =============================================================================

# Supabase — Postgres + Auth + Realtime + Storage.
#   Signup:  https://supabase.com/dashboard
#   Keys:    Settings → API
#   Tier:    Free up to 500MB DB, 2GB storage, 50K MAU
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# P1 — LEAD SOURCING + SIGNAL DETECTION
# =============================================================================

# Apollo.io — People + company search + enrichment.
#   Signup:  https://www.apollo.io/sign-up
#   Keys:    https://app.apollo.io/#/settings/integrations/api_keys
#   Tier:    Free 50 credits/mo, Basic $49/mo
APOLLO_API_KEY=

# Google Places — local business lookup (name, address, phone, site).
#   Enable:  https://console.cloud.google.com/apis/library/places-backend.googleapis.com
#   Keys:    https://console.cloud.google.com/apis/credentials
#   Tier:    $200/mo free credit = ~40K place-details calls
GOOGLE_PLACES_API_KEY=

# BuiltWith — tech-stack + spend estimates for outbound targeting.
#   Signup:  https://api.builtwith.com/
#   Tier:    Free 100/mo trial, $295/mo for real lookups
BUILTWITH_API_KEY=

# Hunter.io — email finder (ONLY for verification / fallback, we don't cold-email).
#   Signup:  https://hunter.io/users/sign_up
#   Tier:    Free 25/mo
HUNTER_API_KEY=


# =============================================================================
# P1 — DOCUMENT SIGNING + TRANSACTIONAL EMAIL
# =============================================================================

# Dropbox Sign (HelloSign) — contract signing for Managed Service deals.
#   Signup:  https://app.hellosign.com/account/signUp
#   Keys:    https://app.hellosign.com/home/myAccount#api
#   Tier:    Free 3 docs/mo, $20/mo for 5 docs/mo
DROPBOX_SIGN_API_KEY=

# Resend — TRANSACTIONAL email only (receipts, booking confirms, NOT outbound).
#   Signup:  https://resend.com/signup
#   Keys:    https://resend.com/api-keys
#   Tier:    Free 100/day, 3K/mo
RESEND_API_KEY=


# =============================================================================
# P1 — ANALYTICS + MONITORING
# =============================================================================

# PostHog — product analytics + session replay.
#   Signup:  https://app.posthog.com/signup
#   Keys:    Project Settings
#   Tier:    Free 1M events/mo
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — error tracking.
#   Signup:  https://sentry.io/signup/
#   Tier:    Free 5K errors/mo
VITE_SENTRY_DSN=


# =============================================================================
# P2 — DATA + MARKET LAYERS (TrendPulse)
# =============================================================================

# CoinGecko — FREE, no key required. Optional Pro for higher limits.
# COINGECKO_API_KEY=

# Kalshi — event contracts. Optional.
#   Signup:  https://kalshi.com/
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=

# Polymarket — public API, no key required.


# =============================================================================
# P2 — BANKING (Plaid) — only when payouts graduate past Stripe Connect
# =============================================================================

# Plaid — ACH bank linking.
#   Signup:  https://dashboard.plaid.com/signup
#   Keys:    https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=


# =============================================================================
# P2 — CALENDAR OAUTH (if you later support Google Cal direct)
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# =============================================================================
# SERVER CONFIG
# =============================================================================

# CORS — the domain the API should accept. In prod set to goated.solutions.
CORS_ORIGIN=https://goated.solutions

# Rate limiting (requests/min/IP)
RATE_LIMIT_RPM=60

# Max concurrent API connections
MAX_API_CONNECTIONS=100

# Lead pool size (for demo data)
MAX_LEAD_POOL=500000

# Optional Redis URL (caching + distributed rate-limit)
REDIS_URL=

# Vercel Analytics (auto-injected on Vercel, no key needed)
VITE_VERCEL_ANALYTICS=true
