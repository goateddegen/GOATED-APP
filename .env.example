# =============================================================================
# GOATED Solutions v3 — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your keys
# cp .env.example .env.local
# =============================================================================

# ─── Supabase (BaaS — Auth, Database, Realtime, Storage) ─────────────
# Create project: https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Apollo.io — Lead enrichment & people search ─────────────────────
# Get your key: https://app.apollo.io/#/settings/integrations/api_keys
APOLLO_API_KEY=

# ─── CoinGecko — Free, no key required (auto-works) ─────────────────
# Optional Pro key for higher rate limits:
# COINGECKO_API_KEY=

# ─── Payments ─────────────────────────────────────────────────────────
# Stripe — Fiat payments & invoicing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# ─── Banking — Plaid (ACH bank linking) ───────────────────────────────
# Get keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# ─── Prediction Markets ──────────────────────────────────────────────
# Kalshi — Event contracts (optional, falls back to public data)
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=
# Polymarket — No key required (public API)

# ─── AI / LLM ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Monitoring & Observability ───────────────────────────────────────
# Sentry — Error tracking & performance monitoring
VITE_SENTRY_DSN=
# PostHog — Product analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Vercel Analytics (auto-configured on Vercel)
VITE_VERCEL_ANALYTICS=true

# ─── Calendar Integrations ───────────────────────────────────────────
# Cal.com
CAL_API_KEY=
# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Scalability Config ──────────────────────────────────────────────
# Max concurrent API connections
MAX_API_CONNECTIONS=100
# Lead pool size for API (max 500K)
MAX_LEAD_POOL=500000
# Redis URL for caching (optional)
REDIS_URL=
# Rate limiting (requests per minute per user)
RATE_LIMIT_RPM=60
