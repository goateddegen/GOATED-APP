// ---------------------------------------------------------------------------
// Generic event processor (used for mock/demo mode)
// ---------------------------------------------------------------------------
function processWebhookEvent(source, payload, headers) {
  const event = {
    id: `wh_${Date.now()}_${Math.random().toString(36).substring(2, 9)}`,
    source,
    receivedAt: new Date().toISOString(),
    eventType: payload.type || payload.event || payload.event_type || 'unknown',
    payload: sanitizePayload(payload),
    headers: {
      contentType: headers['content-type'],
      userAgent: headers['user-agent'],
      // Capture relevant signature headers (but not the actual signatures for security)
      hasStripeSignature: !!headers['stripe-signature'],
      hasGitHubSignature: !!headers['x-hub-signature-256'],
      hasSlackSignature: !!headers['x-slack-signature'],
    },
    processed: true,
    processingTimeMs: 0,
  };

  return event;
}

// Remove sensitive fields from payload before logging
function sanitizePayload(payload) {
  const sanitized = { ...payload };
  const sensitiveFields = ['password', 'secret', 'token', 'api_key', 'apiKey', 'credit_card', 'ssn'];

  for (const field of sensitiveFields) {
    if (sanitized[field]) {
      sanitized[field] = '[REDACTED]';
    }
  }

  return sanitized;
}

// ---------------------------------------------------------------------------
// Main handler
// ---------------------------------------------------------------------------
export default async function handler(req, res) {
  // Handle CORS preflight
  if (req.method === 'OPTIONS') {
    res.writeHead(204, CORS_HEADERS);
    return res.end();
  }

  Object.entries(CORS_HEADERS).forEach(([key, value]) => {
    res.setHeader(key, value);
  });

  if (req.method !== 'POST') {
    return res.status(405).json({
      error: 'Method not allowed. Use POST.',
      usage: {
        method: 'POST',
        queryParams: {
          source: 'stripe | apollo | github | slack | custom',
        },
        body: 'JSON payload from the external service',
        examples: {
          stripe: 'POST /api/webhook?source=stripe (with Stripe-Signature header)',
          apollo: 'POST /api/webhook?source=apollo',
          github: 'POST /api/webhook?source=github (with X-Hub-Signature-256 header)',
          custom: 'POST /api/webhook?source=custom (any JSON body)',
        },
      },
    });
  }

  const startTime = Date.now();

  try {
    const { source = 'custom' } = req.query;
    const payload = req.body || {};
    const validSources = ['stripe', 'apollo', 'github', 'slack', 'custom'];

    if (!validSources.includes(source)) {
      return res.status(400).json({
        error: `Invalid source "${source}". Valid sources: ${validSources.join(', ')}`,
      });
    }

    // -------------------------------------------------------------------
    // Source-specific validation and handling
    // In production, uncomment the validation functions above and use them.
    // -------------------------------------------------------------------

    let signatureValid = false;
    let signatureChecked = false;

    switch (source) {
      case 'stripe': {
        // In production:
        // const event = validateStripeSignature(req);
        // await handleStripeEvent(event);
        // signatureValid = true;
        // signatureChecked = true;

        const secret = process.env.STRIPE_WEBHOOK_SECRET;
        signatureChecked = !!secret;
        signatureValid = false; // Not actually validated in mock mode
        console.log(`[Webhook] Stripe event received: ${payload.type || 'unknown'}`);
        break;
      }

      case 'apollo': {
        // In production:
        // await handleApolloEvent(payload);

        console.log(`[Webhook] Apollo event received: ${payload.event_type || payload.type || 'unknown'}`);
        break;
      }

      case 'github': {
        // In production:
        // validateGitHubSignature(req, JSON.stringify(payload));
        // const event = req.headers['x-github-event'] || 'unknown';
        // await handleGitHubEvent(event, payload);

        const secret = process.env.GITHUB_WEBHOOK_SECRET;
        signatureChecked = !!secret;
        signatureValid = false;
        console.log(`[Webhook] GitHub event received: ${req.headers['x-github-event'] || payload.action || 'unknown'}`);
        break;
      }

      case 'slack': {
        // In production:
        // validateSlackSignature(req, JSON.stringify(payload));

        // Slack URL verification challenge
        if (payload.type === 'url_verification' && payload.challenge) {
          return res.status(200).json({ challenge: payload.challenge });
        }

        const secret = process.env.SLACK_SIGNING_SECRET;
        signatureChecked = !!secret;
        signatureValid = false;
        console.log(`[Webhook] Slack event received: ${payload.event?.type || payload.type || 'unknown'}`);
        break;
      }

      case 'custom':
      default:
        console.log(`[Webhook] Custom event received`);
        break;
    }

    // Process and log the event
    const event = processWebhookEvent(source, payload, req.headers);
    event.processingTimeMs = Date.now() - startTime;
    event.signatureValidation = {
      checked: signatureChecked,
      valid: signatureValid,
      note: signatureChecked
        ? 'Signature validation configured but running in mock mode'
        : 'No webhook secret configured for this source',
    };

    // Add to in-memory log
    webhookLog.push(event);
    if (webhookLog.length > MAX_LOG_SIZE) {
      webhookLog.splice(0, webhookLog.length - MAX_LOG_SIZE);
    }

    return res.status(200).json({
      received: true,
      eventId: event.id,
      source,
      eventType: event.eventType,
      processedAt: event.receivedAt,
      processingTimeMs: event.processingTimeMs,
      signatureValidation: event.signatureValidation,
      _meta: {
        totalEventsLogged: webhookLog.length,
        storageType: 'in-memory',
        note: 'Webhook events are logged in-memory. Connect a database or message queue for production use.',
        secretsNeeded: {
          stripe: {
            envVar: 'STRIPE_WEBHOOK_SECRET',
            configured: !!process.env.STRIPE_WEBHOOK_SECRET,
            getKeyAt: 'https://dashboard.stripe.com/webhooks',
          },
          apollo: {
            envVar: 'APOLLO_WEBHOOK_SECRET',
            configured: !!process.env.APOLLO_WEBHOOK_SECRET,
            getKeyAt: 'https://app.apollo.io/',
          },
          github: {
            envVar: 'GITHUB_WEBHOOK_SECRET',
            configured: !!process.env.GITHUB_WEBHOOK_SECRET,
            getKeyAt: 'Set in GitHub repo Settings -> Webhooks',
          },
          slack: {
            envVar: 'SLACK_SIGNING_SECRET',
            configured: !!process.env.SLACK_SIGNING_SECRET,
            getKeyAt: 'https://api.slack.com/apps',
          },
        },
      },
    });
  } catch (error) {
    console.error('Webhook processing error:', error);

    // For signature validation failures, return 401
    if (error.message.includes('signature') || error.message.includes('Signature')) {
      return res.status(401).json({
        error: 'Webhook signature validation failed',
        message: error.message,
      });
    }

    return res.status(500).json({
      error: 'Internal server error',
      message: error.message,
    });
  }
}
