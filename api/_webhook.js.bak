// =============================================================================
// GOATED Solutions - Webhook Receiver API
// =============================================================================
// Endpoint: POST /api/webhook
//
// Query Parameters:
//   - source: "stripe" | "apollo" | "github" | "slack" | "custom"
//
// Receives webhooks from external integrations and processes them.
// Each source has its own signature validation and event handling.
//
// API Keys / Secrets Required:
//   - STRIPE_WEBHOOK_SECRET -> https://dashboard.stripe.com/webhooks
//   - APOLLO_WEBHOOK_SECRET -> https://app.apollo.io/ (webhook settings)
//   - GITHUB_WEBHOOK_SECRET -> Set in your GitHub repo webhook settings
//   - SLACK_SIGNING_SECRET  -> https://api.slack.com/apps (Basic Information)
//
// Security: In production, ALWAYS validate webhook signatures to prevent
// spoofed requests. See commented-out validation code for each source.
// =============================================================================

const CORS_HEADERS = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Methods': 'POST, OPTIONS',
  'Access-Control-Allow-Headers': 'Content-Type, Authorization, Stripe-Signature, X-Hub-Signature-256, X-Slack-Signature, X-Slack-Request-Timestamp',
};

// ---------------------------------------------------------------------------
// In-memory webhook event log
// In production, persist these to a database or message queue (e.g., Redis,
// AWS SQS, RabbitMQ) for reliable processing.
// ---------------------------------------------------------------------------
const webhookLog = [];
const MAX_LOG_SIZE = 500;

// ---------------------------------------------------------------------------
// Stripe webhook signature validation (commented out)
// ---------------------------------------------------------------------------
/*
