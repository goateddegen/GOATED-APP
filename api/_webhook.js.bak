      console.log(`Unhandled Stripe event: ${event.type}`);
  }
}
*/

// ---------------------------------------------------------------------------
// GitHub webhook signature validation (commented out)
// ---------------------------------------------------------------------------
/*
import crypto from 'crypto';

function validateGitHubSignature(req, rawBody) {
  const signature = req.headers['x-hub-signature-256'];
  const secret = process.env.GITHUB_WEBHOOK_SECRET;

  if (!signature || !secret) {
    throw new Error('Missing GitHub signature or webhook secret');
  }

  const hmac = crypto.createHmac('sha256', secret);
  const digest = 'sha256=' + hmac.update(rawBody).digest('hex');

  if (!crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(digest))) {
    throw new Error('Invalid GitHub webhook signature');
  }

  return true;
}

async function handleGitHubEvent(event, payload) {
  switch (event) {
    case 'push':
      console.log(`Push to ${payload.repository?.full_name}: ${payload.commits?.length} commits`);
      break;
    case 'pull_request':
      console.log(`PR ${payload.action}: ${payload.pull_request?.title}`);
      break;
    case 'issues':
      console.log(`Issue ${payload.action}: ${payload.issue?.title}`);
      break;
    default:
      console.log(`GitHub event: ${event}`);
  }
}
*/

// ---------------------------------------------------------------------------
// Slack webhook signature validation (commented out)
// ---------------------------------------------------------------------------
/*
import crypto from 'crypto';

function validateSlackSignature(req, rawBody) {
  const timestamp = req.headers['x-slack-request-timestamp'];
  const signature = req.headers['x-slack-signature'];
  const signingSecret = process.env.SLACK_SIGNING_SECRET;

  if (!timestamp || !signature || !signingSecret) {
    throw new Error('Missing Slack signature headers or signing secret');
  }

  // Check timestamp is within 5 minutes to prevent replay attacks
  const fiveMinutesAgo = Math.floor(Date.now() / 1000) - (60 * 5);
  if (parseInt(timestamp, 10) < fiveMinutesAgo) {
    throw new Error('Slack request timestamp too old');
  }

  const sigBaseString = `v0:${timestamp}:${rawBody}`;
  const mySignature = 'v0=' + crypto
    .createHmac('sha256', signingSecret)
    .update(sigBaseString)
    .digest('hex');

  if (!crypto.timingSafeEqual(Buffer.from(mySignature), Buffer.from(signature))) {
    throw new Error('Invalid Slack webhook signature');
  }

  return true;
}
*/

// ---------------------------------------------------------------------------
// Apollo.io webhook handler (commented out)
// ---------------------------------------------------------------------------
/*
